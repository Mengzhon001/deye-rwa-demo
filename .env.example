# Export these in the revenue server environment. Keep real values out of Git.
# Or copy this file to repository-root .env.revenue (loaded by revenue server/reset/seed commands; credentials are read only by the server).
# Set credentials directly below, or point DEYE_CREDENTIALS_FILE to a local ignored note.
# Explicit environment credentials below take precedence over the note.
DEYE_CREDENTIALS_FILE=
DEYE_REGION=eu
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
DEYE_COMPANY_ID=

# Verify these against a real station before setting verified=true.
DEYE_GENERATION_FIELD=generationValue
DEYE_EXPORT_FIELD=gridValue
DEYE_ENERGY_TO_KWH=1
DEYE_POWER_TO_KW=0.001
DEYE_CAPACITY_TO_KW=1
DEYE_CURRENCY=
DEYE_TIMESTAMP_UNIT=seconds
DEYE_MAPPING_VERIFIED=false
DEYE_MAPPING_NOTE=
# Unresolved source inconsistencies force provisional forecast approval even after field verification.
DEYE_QUALITY_WARNINGS=

# Replay uses an archived raw capture; it never silently falls back to synthetic.
DEYE_REPLAY_FILE=
REVENUE_DATA_DIR=.data/revenue
REVENUE_PORT=4174
HARDHAT_NETWORK=localhost

# Empty by default. Set a verified station ID to enable live collection.
REVENUE_AUTO_SYNC_STATION_ID=
REVENUE_MONITOR_LIVE=false
REVENUE_INITIAL_REPLAY=false

REVENUE_GUIDANCE_ENABLED=true
REVENUE_DISTRIBUTION_INTERVAL_MONTHS=1
