{
  "name": "green-energy-raw-offchain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:deploy": "node --import tsx src/cli.ts deploy-facility",
    "demo:simulate": "node --import tsx src/cli.ts simulate-period",
    "demo:lifecycle": "node --import tsx src/cli.ts emit-lifecycle",
    "test:demo": "node --import tsx src/validate.ts",
    "test:revenue": "node --import tsx --test src/revenue/model.test.ts src/revenue/billing.test.ts src/revenue/deye.test.ts"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
